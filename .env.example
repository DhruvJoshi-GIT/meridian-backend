# Server
PORT=4000
NODE_ENV=development

# SQLite file (swap provider in prisma/schema.prisma to "postgresql" and point this at a Postgres URL to migrate)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# When false, unauthenticated requests act as the seeded demo analyst (handy while the UI has no login screen).
# Set to true to require a Bearer token on every /api route except /api/auth/* and /api/health.
AUTH_REQUIRED=false

# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8443
