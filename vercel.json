{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{prisma,node_modules/.prisma/client}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "buildCommand": "prisma generate && npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "public",
  "installCommand": "npm ci"
}
